# Copy to .env and fill in your values. Never commit .env.
# Resolution order: CLI argument -> BAYAN_* here -> OPENAI_API_KEY.

# Required unless OPENAI_API_KEY is set:
BAYAN_API_KEY=

# Optional; defaults shown:
BAYAN_BASE_URL=https://api.z.ai/api/coding/paas/v4/
BAYAN_LLM_MODEL=glm-5.2

# Fallback key when BAYAN_API_KEY is unset:
OPENAI_API_KEY=
